              </outputs>
            </component>
            <component
              refId="Package\DRA01_CAPTURE_BALANCE\Premium ADO NET Source 1"
              componentClassID="Microsoft.ManagedComponentHost"
              contactInfo="KingswaySoft Inc.; http://www.kingswaysoft.com; support@kingswaysoft.com; Copyright (c) 2011-2025 KingswaySoft Inc."
              description="Read data from an ADO.NET connection."
              name="Premium ADO NET Source 1"
              usesDispositions="true"
              version="2">
              <properties>
                <property
                  dataType="System.String"
                  expressionType="Notify"
                  name="DataSource">&lt;&lt;Custom Command&gt;&gt;</property>
                <property
                  dataType="System.String"
                  expressionType="Notify"
                  name="Command">DECLARE @FE_MIGRACION DATE = '2025-07-03';

WITH BASE AS (
    SELECT *,
        COALESCE(
            NULLIF(CAST(CO_LINEA_CREDITO_ACTIVA AS VARCHAR), ''), 
            NULLIF(CAST(CO_PROYECTO AS VARCHAR), '')

        ) AS FACILITY
    FROM OPERACION_ACTIVA
    WHERE 
        FE_LINEA_TIEMPO = @FE_MIGRACION
        AND CO_PERSONA_FUENTE_RECURSO IS NOT NULL
),
NUMERADOS AS (
    SELECT 
        (SELECT PR.CO_APROBACION_CFS 
         FROM PROYECTO PR 
         WHERE PR.CO_PROYECTO = FACILITY 
         AND PR.FE_LINEA_TIEMPO = @FE_MIGRACION) AS PADRE_SUPERIOR,
        FACILITY,
        CO_PROYECTO,        
        CO_OPERACION_ACTIVA,
        CO_PERSONA_FUENTE_RECURSO,
        NB_PERSONA_FUENTE_RECURSO,
        DE_STATUS_OPERACION,
        DE_INDICE_TASA_BASE_INTERES, 
        ROW_NUMBER() OVER (
            PARTITION BY CO_PROYECTO, FACILITY
            ORDER BY CO_OPERACION_ACTIVA
        ) AS HIJO_NUM,
        COUNT(*) OVER (
            PARTITION BY CO_PROYECTO, FACILITY
        ) AS TOTAL_HIJOS,
        MAX(CASE WHEN CO_PERSONA_FUENTE_RECURSO = 1508 THEN 1 ELSE 0 END) OVER (
            PARTITION BY CO_PROYECTO, FACILITY
        ) AS GRUPO_TIENE_1508,
        FE_CONTRATO,
        FE_VENCIMIENTO,
        FE_PROXIMO_COBRO_INTERES,
        FE_PROXIMO_COBRO_CAPITAL,
        (SELECT TOP 1 MAX(FE_CONTRATO) AS FECHA_MAXIMA FROM [datamart].[dbo].[operacion_pasiva] WHERE co_operacion_pasiva = CO_OPERACION_CMPNSCION) AS FE_CONTRATO_PASIVA,
        (SELECT TOP 1 MAX(FE_VENCIMIENTO) AS FECHA_MAXIMA FROM [datamart].[dbo].[operacion_pasiva] WHERE co_operacion_pasiva = CO_OPERACION_CMPNSCION) AS FE_VENCIMIENTO_PASIVA,
        CO_OPERACION_CMPNSCION,
        TA_CMPNSCION,
        TI_RIESGO_OPERACION_ACTIVA,
        FE_VENCIMIENTO_KFW,
        (SELECT MARGIN FROM [DBO].[PHOENIX_LN_ACCT_INT_OPT] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3)) AS [TOTAL_MARGEN],
        (SELECT MARGIN FROM [DBO].[PHOENIX_LN_ACCT_ALT_INT] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3) AND ALT_INT_ID = '4') AS 'MARGEN FFC',
        (SELECT STATUS FROM [DBO].[PHOENIX_LN_ACCT_ALT_INT] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3) AND ALT_INT_ID = '4') AS 'ESTADO FFC',
        (SELECT CURRENT_RATE FROM [DBO].[PHOENIX_LN_ACCT_ALT_INT] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3) AND ALT_INT_ID = '4') AS 'TASA FFC',
        (SELECT END_ACCR_DT FROM [DBO].[PHOENIX_LN_ACCT_ALT_INT] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3) AND ALT_INT_ID = '4') AS 'FE_VENCIMIENTO_FFC',
        (SELECT ACCR_BASIS FROM [DBO].[PHOENIX_LN_ACCT_INT_OPT] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3)) AS 'ACCR BASIS OPT',
        (SELECT ACCR_BASIS FROM [DBO].[PHOENIX_LN_ACCT_ALT_INT] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3) AND ALT_INT_ID = '4') AS 'ACCR BASIS ALT',
        MO_APROBADO_MONEDA_ORIGEN,
        MO_TOTAL_DESEMBOLSADO_ORIGEN,       
        (SELECT TOP 1 CUR_BAL FROM [dbo].[Phoenix_ln_disb_int] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3) AND STATUS = 'Active' ORDER BY EFFECTIVE_DT DESC ) AS [CUR_BAL_PHOENIX], --CREADO   
        (SELECT CASE WHEN COUNT(*) &gt;= 1 THEN 'BAND' ELSE NULL END FROM [dbo].[Phoenix_ln_disb_int] WHERE STATUS = 'Active' AND ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA))) AS [PRINCIPALINT.RATE.TIER.TYPE_PHOENIX],  --CREADO
        ISNULL((SELECT TOP 1 MARGIN FROM [dbo].[Phoenix_ln_disb_int] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3) AND STATUS = 'Active' ORDER BY EFFECTIVE_DT DESC), 0) AS [MARGIN_PHOENIX], --CREADO

        (SELECT TOP 1 NEW_RATE FROM [dbo].[Phoenix_gb_acct_rate] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3)  ORDER BY EFFECTIVE_DT DESC ) AS [NEW_RATE_PHOENIX], --CREADO 
        
        (SELECT SUM(MO_MONEDA_ORIGEN) FROM DESEMBOLSO WHERE CO_OPERACION_ACTIVA = BA.CO_OPERACION_ACTIVA AND CO_TRANSACCION IN ('350','355') AND (
                BA.CO_PERSONA_FUENTE_RECURSO = 1508
                OR (BA.CO_PERSONA_FUENTE_RECURSO &lt;&gt; 1508 AND (DE_DESEMBOLSO NOT LIKE '%KFW%' OR DE_DESEMBOLSO IS NULL))
        )) AS 'TOTAL DESEMBOLSADO',
        MO_X_DESEMBOLSAR_ORIGEN,
        (SELECT SUM(MO_MONEDA_ORIGEN) FROM RECUPERACION WHERE CO_OPERACION_ACTIVA = BA.CO_OPERACION_ACTIVA AND CO_TRANSACCION IN ('300') AND TI_RECUPERACION = 'CAPITAL' AND (
                BA.CO_PERSONA_FUENTE_RECURSO = 1508
                OR (BA.CO_PERSONA_FUENTE_RECURSO &lt;&gt; 1508 AND (DE_RECUPERACION NOT LIKE '%KFW%' OR DE_RECUPERACION IS NULL))
        )) AS 'TOTAL RECUPERADO',

        SA_ACTUAL_MONEDA_ORIGEN,
        MO_INTERESES_X_COBRAR, 
        MO_INTERES_CMPNSCION_ACUM_X_COBRAR_ORGEN,
        MO_INTERES_VNCDO_X_COBRAR, 
        CO_PERSONA_PRESTATARIO,
        CO_STATUS_OPERACION_ACTIVA,  
        CO_GRUPO_PRODUCTO, 
        NB_GRUPO_PRODUCTO, 
        CO_OPERACION_PASIVA_RELACIONADA,
        @FE_MIGRACION AS FE_MIGRACION,
        (SELECT SUM(mo_capital_moneda_origen) FROM amortizacion_plan_activa WHERE BA.CO_OPERACION_ACTIVA = co_operacion_activa) AS MO_CAPITAL_MONEDA_ORIGEN, --CREADO
        (SELECT SUM(mo_interes_usd) FROM amortizacion_plan_activa WHERE BA.CO_OPERACION_ACTIVA = co_operacion_activa) AS MO_INTERES_USD, --CREADO
        CASE WHEN ROW_NUMBER() OVER (PARTITION BY CO_PROYECTO, FACILITY ORDER BY CO_OPERACION_ACTIVA) = 1 THEN 'ORIGINAL' ELSE 'KFW' END AS CO_CONDICION, --CREADO
        (SELECT co_SWIFT_moneda FROM moneda WHERE moneda.co_moneda = CO_MONEDA_ORIGEN_OPERACION) AS CURRENCY --CREADO
    FROM BASE BA
)
SELECT
    A.PADRE_SUPERIOR,
    A.FACILITY,
    A.FE_CONTRATO,
    A.CO_OPERACION_ACTIVA,
    A.CO_PERSONA_FUENTE_RECURSO,
    A.NB_PERSONA_FUENTE_RECURSO,
    A.DE_STATUS_OPERACION,
    A.HIJO_NUM,
    A.CO_CONDICION,--AGREGADO
    --CASE WHEN A.HIJO_NUM = 1 THEN NULL ELSE PADRE.CO_OPERACION_ACTIVA END AS CO_OPERACION_ORIGINAL,
    A.FE_VENCIMIENTO,
    A.CO_OPERACION_CMPNSCION,
    A.TA_CMPNSCION,
    --A.TI_RIESGO_OPERACION_ACTIVA,
    A.FE_VENCIMIENTO_KFW,
    A.FE_MIGRACION,
    A.[TOTAL_MARGEN],           
    A.[MARGEN FFC] AS 'MARGEN_PHOENIX_KFW',
    ABS(A.[TOTAL_MARGEN] - B.[TOTAL_MARGEN]) AS ABARATAMIENTO,
    A.[ESTADO FFC],
    A.[TASA FFC],
    A.[FE_VENCIMIENTO_FFC],
    A.MO_APROBADO_MONEDA_ORIGEN,
    --A.[TOTAL DESEMBOLSADO] AS 'MO_TOTAL_DESEMBOLSADO_ORIGEN',
    A.MO_TOTAL_DESEMBOLSADO_ORIGEN,
    A.MO_X_DESEMBOLSAR_ORIGEN,
    A.MO_INTERESES_X_COBRAR,
    A.MO_CAPITAL_MONEDA_ORIGEN,
    A.MO_INTERES_CMPNSCION_ACUM_X_COBRAR_ORGEN,
    --A.[TOTAL RECUPERADO] AS 'MO_TOTAL_RECUPERADO_ORIGEN', 
    A.SA_ACTUAL_MONEDA_ORIGEN, 
    --A.MO_INTERESES_X_COBRAR, 
    A.MO_INTERES_VNCDO_X_COBRAR, 
    A.MO_INTERES_USD,
    --A.CO_PERSONA_PRESTATARIO,
    --A.CO_STATUS_OPERACION_ACTIVA, 
    --A.CO_GRUPO_PRODUCTO,
    --A.NB_GRUPO_PRODUCTO, 
    --A.CO_OPERACION_PASIVA_RELACIONADA,
    A.[ACCR BASIS OPT],
    A.[ACCR BASIS ALT], 
    A.NEW_RATE_PHOENIX,
    A.MARGIN_PHOENIX,
    A.CUR_BAL_PHOENIX,    
    
     /* ------------ FV: BALANCE.MAINTENANCE.ADJUST.PROP ------------ */
    CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN
    (
        SELECT STRING_AGG(Label, '!!')
        FROM (SELECT CASE WHEN COALESCE(AGG.SUM_ORIG, 0) &lt;&gt; 0 AND (COALESCE(AGG.SUM_KFW, 0) &lt;&gt; 0 OR COALESCE(AGG.HAS_FFC_KFW, 0) &lt;&gt; 0) THEN 'ACCOUNT' END AS Label
            UNION ALL
            SELECT CASE WHEN COALESCE(AGG.SUM_INT_X_COBRAR, 0) &gt; 0 OR COALESCE(AGG.HAS_INT_X_COBRAR_FUT, 0) &lt;&gt; 0 THEN 'PRINCIPALINT' END
            UNION ALL
            SELECT CASE WHEN COALESCE(AGG.HAS_DWCOMMITMENT, 0) &lt;&gt; 0 AND (COALESCE(AGG.SUM_DESEM_FFC_KFW, 0) &lt;&gt; 0 OR COALESCE(AGG.SUM_DESEM_KFW, 0) &lt;&gt; 0) THEN 'DWCOMMITMENT' END
            UNION ALL
            SELECT CASE WHEN COALESCE(AGG.SUM_INT_VENCIDO, 0) &gt; 0 OR COALESCE(AGG.SUM_INT_VENCIDO_FUT, 0) &lt;&gt; 0 THEN 'INTVENCIDO' END
            UNION ALL
            SELECT CASE WHEN COALESCE(AGG.HAS_INT_FFC, 0) &gt; 0 AND (COALESCE(AGG.SUM_INT_FFC_FUT, 0) &lt;&gt; 0 OR COALESCE(AGG.SUM_INT_FFC, 0) &lt;&gt; 0) THEN 'INTERESTFFC' END
            UNION ALL
            SELECT CASE WHEN COALESCE(AGG.HAS_INT_KFW, 0) &gt; 0 AND (COALESCE(AGG.HAS_INT_KFW, 0) &lt;&gt; 0 OR COALESCE(AGG.HAS_INT_KWF_FFC, 0) &lt;&gt; 0) THEN 'INTERESTKWF'  END
        ) AS CON
        WHERE Label IS NOT NULL
    )ELSE '' END AS [BALANCE.MAINTENANCE.ADJUST.PROP],    

    CASE WHEN A.CO_CONDICION='ORIGINAL' THEN(
            SELECT STRING_AGG('ADJUST.PROP:'+CAST(Num AS VARCHAR(10))+':1','!!')
            FROM    (SELECT ROW_NUMBER() OVER(ORDER BY(SELECT NULL)) AS Num
            FROM    (SELECT 1 AS Flag WHERE COALESCE(AGG.SUM_ORIG,0)&lt;&gt;0 AND (COALESCE(AGG.SUM_KFW,0)&lt;&gt;0 OR COALESCE(AGG.HAS_FFC_KFW, 0) &lt;&gt; 0)                           -- ACCOUNT
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.SUM_INT_X_COBRAR,0) &lt;&gt; 0 OR COALESCE(AGG.HAS_INT_X_COBRAR_FUT,0) &lt;&gt; 0                                  -- PRINCIPALINT
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.HAS_DWCOMMITMENT,0) &lt;&gt; 0 AND (COALESCE(AGG.SUM_DESEM_FFC_KFW,0) &lt;&gt; 0 OR COALESCE(AGG.SUM_DESEM_KFW,0) &lt;&gt; 0) -- DWCOMMITMENT
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.SUM_INT_VENCIDO,0) &lt;&gt; 0 OR COALESCE(AGG.SUM_INT_VENCIDO_FUT,0) &lt;&gt; 0                                     -- INTVENCIDO
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.HAS_INT_FFC,0) &lt;&gt; 0 AND (COALESCE(AGG.SUM_INT_FFC_FUT,0) &lt;&gt; 0 OR COALESCE(AGG.SUM_INT_FFC,0) &lt;&gt; 0)        -- INTERESTFFC
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.HAS_INT_KFW,0) &lt;&gt; 0 AND (COALESCE(AGG.HAS_INT_KFW,0) &lt;&gt; 0 OR COALESCE(AGG.HAS_INT_KWF_FFC,0) &lt;&gt; 0 OR COALESCE(AGG.HAS_INT_KWF_FFC,0)&lt;&gt;0) -- INTERESTKWF
            ) S
        ) N
    ) ELSE '' END AS [FNQ.BALANCE.MAINTENANCE.ADJUST.PROP], 

    
   /* ------------- BALANCE.MAINTENANCE.ADJ.BAL.TYPE ------------- */
    CASE WHEN A.CO_CONDICION='ORIGINAL' THEN (SELECT STRING_AGG(Label,'!!') FROM (
        SELECT CASE WHEN COALESCE(AGG.SUM_ORIG, 0) &lt;&gt; 0 AND (COALESCE(AGG.SUM_KFW, 0) &lt;&gt; 0 OR COALESCE(AGG.HAS_FFC_KFW, 0) &lt;&gt; 0) THEN 'CURACCOUNT' END AS Label
        UNION ALL 
        SELECT CASE WHEN COALESCE(AGG.SUM_INT_X_COBRAR, 0) &lt;&gt; 0 OR COALESCE(AGG.HAS_INT_X_COBRAR_FUT, 0) &lt; &gt;0 THEN 'ACCPRINCIPALINT' END
        UNION ALL 
        SELECT CASE WHEN COALESCE(AGG.HAS_DESEM_KFW, 0) &lt; &gt;0 AND (COALESCE(AGG.SUM_DESEM_FFC_KFW, 0) &lt;&gt; 0 OR COALESCE(AGG.SUM_DESEM_KFW, 0)&lt;&gt;0) THEN 'UTLDWCOMMITMENT' END
        UNION ALL 
        SELECT CASE WHEN COALESCE(AGG.SUM_INT_VENCIDO, 0) &lt;&gt; 0 OR COALESCE(AGG.SUM_INT_VENCIDO_FUT, 0) &lt;&gt; 0 THEN 'ACCINTVENCIDO' END
        UNION ALL 
        SELECT CASE WHEN COALESCE(AGG.HAS_INT_FFC, 0) &lt;&gt; 0 AND (COALESCE(AGG.SUM_INT_FFC_FUT, 0) &lt;&gt; 0 OR COALESCE(AGG.SUM_INT_FFC, 0) &lt;&gt; 0) THEN 'ACCINTERESTFFC' END
        UNION ALL 
        SELECT CASE WHEN COALESCE(AGG.HAS_INT_KFW, 0) &lt;&gt; 0 AND (COALESCE(AGG.HAS_INT_KFW, 0) &lt;&gt; 0 OR COALESCE(AGG.HAS_INT_KWF_FFC, 0 ) &lt;&gt; 0) THEN 'ACCINTERESTKWF' END
    ) CON WHERE Label IS NOT NULL) ELSE '' END AS [BALANCE.MAINTENANCE.ADJ.BAL.TYPE],       
    
    CASE WHEN A.CO_CONDICION='ORIGINAL' THEN(
            SELECT STRING_AGG('ADJ.BAL.TYPE:'+CAST(Num AS VARCHAR(10))+':1','!!')
            FROM    (SELECT ROW_NUMBER() OVER(ORDER BY(SELECT NULL)) AS Num
            FROM    (SELECT 1 AS Flag WHERE COALESCE(AGG.SUM_ORIG,0)&lt;&gt;0 AND (COALESCE(AGG.SUM_KFW,0)&lt;&gt;0 OR COALESCE(AGG.HAS_FFC_KFW, 0) &lt;&gt; 0)                           -- ACCOUNT
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.SUM_INT_X_COBRAR,0) &lt;&gt; 0 OR COALESCE(AGG.HAS_INT_X_COBRAR_FUT,0) &lt;&gt; 0                                  -- PRINCIPALINT
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.HAS_DWCOMMITMENT,0) &lt;&gt; 0 AND (COALESCE(AGG.SUM_DESEM_FFC_KFW,0) &lt;&gt; 0 OR COALESCE(AGG.SUM_DESEM_KFW,0) &lt;&gt; 0) -- DWCOMMITMENT
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.SUM_INT_VENCIDO,0) &lt;&gt; 0 OR COALESCE(AGG.SUM_INT_VENCIDO_FUT,0) &lt;&gt; 0                                     -- INTVENCIDO
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.HAS_INT_FFC,0) &lt;&gt; 0 AND (COALESCE(AGG.SUM_INT_FFC_FUT,0) &lt;&gt; 0 OR COALESCE(AGG.SUM_INT_FFC,0) &lt;&gt; 0)        -- INTERESTFFC
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.HAS_INT_KFW,0) &lt;&gt; 0 AND (COALESCE(AGG.HAS_INT_KFW,0) &lt;&gt; 0 OR COALESCE(AGG.HAS_INT_KWF_FFC,0) &lt;&gt; 0 OR COALESCE(AGG.HAS_INT_KWF_FFC,0)&lt;&gt;0) -- INTERESTKWF
            ) S
        ) N
    ) ELSE '' END AS [FNQ.BALANCE.MAINTENANCE.ADJ.BAL.TYPE],

    /* ------------- BALANCE.MAINTENANCE.NEW.BAL.AMT ------------- */
    CASE WHEN A.CO_CONDICION='ORIGINAL' THEN (
      SELECT STRING_AGG(CONVERT(VARCHAR(50), CAST(val AS DECIMAL(38,2))), '!!')
      FROM (VALUES
        (CASE WHEN COALESCE(AGG.SUM_ORIG, 0) &lt;&gt; 0 AND (COALESCE(AGG.SUM_KFW, 0) &lt;&gt; 0 OR COALESCE(AGG.HAS_FFC_KFW, 0) &lt;&gt; 0) THEN -ABS(AGG.SUM_KFW) END),
        (CASE WHEN COALESCE(AGG.SUM_INT_X_COBRAR, 0) &lt;&gt; 0 OR COALESCE(AGG.HAS_INT_X_COBRAR_FUT, 0) &lt;&gt; 0 THEN -ABS(AGG.SUM_INT_X_COBRAR) END),
        (CASE WHEN COALESCE(AGG.HAS_DESEM_KFW, 0) &lt;&gt; 0 AND (COALESCE(AGG.SUM_DESEM_FFC_KFW, 0) &lt;&gt; 0 OR COALESCE(AGG.SUM_DESEM_KFW, 0) &lt;&gt; 0) THEN -ABS(AGG.HAS_DESEM_KFW) END),
        (CASE WHEN COALESCE(AGG.SUM_INT_VENCIDO, 0) &lt;&gt; 0 OR COALESCE(AGG.SUM_INT_VENCIDO_FUT, 0) &lt;&gt; 0 THEN -ABS(AGG.SUM_INT_VENCIDO_FUT) END),
        (CASE WHEN COALESCE(AGG.HAS_INT_FFC, 0) &lt;&gt; 0 AND (COALESCE(AGG.SUM_INT_FFC_FUT, 0) &lt;&gt; 0 OR COALESCE(AGG.SUM_INT_FFC, 0) &lt;&gt; 0) THEN -ABS(AGG.HAS_INT_FFC) END),
        (CASE WHEN COALESCE(AGG.HAS_INT_KFW, 0) &lt;&gt; 0 AND (COALESCE(AGG.HAS_INT_KWF_FFC, 0) &lt;&gt; 0 OR COALESCE(AGG.HAS_INT_KFW, 0) &lt;&gt; 0) THEN -ABS(AGG.HAS_INT_KFW) END)
      ) t(val)
      WHERE val IS NOT NULL AND val &lt;&gt; 0   -- o simplemente: WHERE val &lt; 0
    ) ELSE '' END AS [BALANCE.MAINTENANCE.NEW.BAL.AMT],
    
    CASE WHEN A.CO_CONDICION='ORIGINAL' THEN(
            SELECT STRING_AGG('NEW.BAL.AMT:'+CAST(Num AS VARCHAR(10))+':1','!!')
            FROM    (SELECT ROW_NUMBER() OVER(ORDER BY(SELECT NULL)) AS Num
            FROM    (SELECT 1 AS Flag WHERE COALESCE(AGG.SUM_ORIG,0)&lt;&gt;0 AND (COALESCE(AGG.SUM_KFW,0)&lt;&gt;0 OR COALESCE(AGG.HAS_FFC_KFW, 0) &lt;&gt; 0)                           -- ACCOUNT
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.SUM_INT_X_COBRAR,0) &lt;&gt; 0 OR COALESCE(AGG.HAS_INT_X_COBRAR_FUT,0) &lt;&gt; 0                                  -- PRINCIPALINT
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.HAS_DWCOMMITMENT,0) &lt;&gt; 0 AND (COALESCE(AGG.SUM_DESEM_FFC_KFW,0) &lt;&gt; 0 OR COALESCE(AGG.SUM_DESEM_KFW,0) &lt;&gt; 0) -- DWCOMMITMENT
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.SUM_INT_VENCIDO,0) &lt;&gt; 0 OR COALESCE(AGG.SUM_INT_VENCIDO_FUT,0) &lt;&gt; 0                                     -- INTVENCIDO
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.HAS_INT_FFC,0) &lt;&gt; 0 AND (COALESCE(AGG.SUM_INT_FFC_FUT,0) &lt;&gt; 0 OR COALESCE(AGG.SUM_INT_FFC,0) &lt;&gt; 0)        -- INTERESTFFC
                    UNION ALL SELECT 1 AS Flag WHERE COALESCE(AGG.HAS_INT_KFW,0) &lt;&gt; 0 AND (COALESCE(AGG.HAS_INT_KFW,0) &lt;&gt; 0 OR COALESCE(AGG.HAS_INT_KWF_FFC,0) &lt;&gt; 0 OR COALESCE(AGG.HAS_INT_KWF_FFC,0)&lt;&gt;0) -- INTERESTKWF
            ) S
        ) N
    ) ELSE '' END AS [FNQ.BALANCE.MAINTENANCE.NEW.BAL.AMT]

FROM NUMERADOS A
LEFT JOIN NUMERADOS B
  ON A.FACILITY = B.FACILITY
 AND A.HIJO_NUM = B.HIJO_NUM + 1
LEFT JOIN NUMERADOS PADRE
  ON A.FACILITY = PADRE.FACILITY 
 AND A.CO_PROYECTO = PADRE.CO_PROYECTO
 AND PADRE.HIJO_NUM = 1

/* --------- OUTER APPLY: agregados por FACILITY (una sola vez) --------- */
OUTER APPLY (
  SELECT
    /* ACCOUNT */
    SUM(N2.SA_ACTUAL_MONEDA_ORIGEN) AS SUM_ORIG,
    SUM(CASE WHEN N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION THEN N2.SA_ACTUAL_MONEDA_ORIGEN END) AS SUM_KFW,  
    (SELECT TOP 1 N2b.SA_ACTUAL_MONEDA_ORIGEN FROM NUMERADOS N2b WHERE N2b.FACILITY = A.FACILITY AND N2b.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION AND N2b.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION) AS HAS_FFC_KFW,   /* Solo bandera (no sumar) */

    /* PRINCIPALINT */
    SUM(N2.MO_INTERESES_X_COBRAR) AS SUM_INT_X_COBRAR,    
    (SELECT TOP 1 N2b.MO_INTERESES_X_COBRAR FROM NUMERADOS N2b WHERE N2b.FACILITY = A.FACILITY AND N2b.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION AND N2b.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION) AS HAS_INT_X_COBRAR_FUT,

    /* DWCOMMITMENT */
    (SELECT N2b.MO_TOTAL_DESEMBOLSADO_ORIGEN FROM NUMERADOS N2b WHERE N2b.FACILITY = A.FACILITY AND N2b.MO_TOTAL_DESEMBOLSADO_ORIGEN &lt;&gt; 0 AND N2b.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION) AS HAS_DWCOMMITMENT,
    CASE WHEN EXISTS (SELECT 1 FROM NUMERADOS NX WHERE NX.FACILITY = A.FACILITY AND NX.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION) THEN (SELECT TOP 1 N2b.MO_TOTAL_DESEMBOLSADO_ORIGEN FROM NUMERADOS N2b
       WHERE N2b.CO_CONDICION = 'ORIGINAL' AND N2b.FACILITY = A.FACILITY ORDER BY N2b.FE_VENCIMIENTO_KFW DESC)
    ELSE NULL END AS HAS_DESEM_KFW,

    SUM(CASE WHEN N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION THEN N2.MO_TOTAL_DESEMBOLSADO_ORIGEN END) AS SUM_DESEM_KFW,
    (SELECT TOP 1 N2b.MO_TOTAL_DESEMBOLSADO_ORIGEN FROM NUMERADOS N2b WHERE  N2b.FACILITY = A.FACILITY AND N2b.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION AND N2b.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION) AS SUM_DESEM_FFC_KFW,

    /* INTVENCIDO */
    SUM(N2.MO_INTERES_VNCDO_X_COBRAR) AS SUM_INT_VENCIDO,
    (SELECT TOP 1 N2b.MO_INTERES_VNCDO_X_COBRAR FROM NUMERADOS N2b WHERE N2b.FACILITY = A.FACILITY AND N2b.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION AND N2b.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION) AS SUM_INT_VENCIDO_FUT,

    /* INTERESTFFC */
    (SELECT TOP 1 N2b.MO_INTERES_CMPNSCION_ACUM_X_COBRAR_ORGEN FROM NUMERADOS N2b WHERE  N2b.FACILITY = A.FACILITY AND N2b.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION) AS HAS_INT_FFC,
    SUM(CASE WHEN N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION THEN N2.MO_INTERES_CMPNSCION_ACUM_X_COBRAR_ORGEN END) AS SUM_INT_FFC,
   (SELECT TOP 1 N2b.MO_INTERES_CMPNSCION_ACUM_X_COBRAR_ORGEN FROM NUMERADOS N2b WHERE N2b.FACILITY = A.FACILITY AND N2b.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION AND N2b.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION) AS SUM_INT_FFC_FUT,

    /* INTERESTKWF */
    (SELECT TOP 1 N2b.MO_INTERESES_X_COBRAR FROM NUMERADOS N2b WHERE  N2b.FACILITY = A.FACILITY AND N2b.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION) AS HAS_INT_KFW,   
    (SELECT TOP 1 N2b.MO_INTERESES_X_COBRAR FROM NUMERADOS N2b WHERE N2b.FACILITY = A.FACILITY AND N2b.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION AND N2b.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION) AS HAS_INT_KWF_FFC
  FROM NUMERADOS N2
  WHERE N2.FACILITY = A.FACILITY
) AGG

WHERE A.TOTAL_HIJOS &gt;= 2
  AND A.GRUPO_TIENE_1508 = 1
  --AND A.FACILITY IN ('CFX0000003251  ')
ORDER BY A.PADRE_SUPERIOR, A.FACILITY, A.HIJO_NUM;
</property>
