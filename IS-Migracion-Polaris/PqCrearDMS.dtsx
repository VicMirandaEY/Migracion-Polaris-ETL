                              dataType="System.Boolean"
                              name="IsConditionalField">false</property>
                            <property
                              dataType="System.Boolean"
                              description="IsIdentityField"
                              name="IsIdentityField">false</property>
                            <property
                              dataType="System.Boolean"
                              name="CanBeConditionalField">true</property>
                            <property
                              dataType="System.Null"
                              name="Tags" />
                          </properties>
                        </externalMetadataColumn>
                      </externalMetadataColumns>
                    </input>
                  </inputs>
                  <outputs>
                    <output
                      refId="Package\Sequence Container TAKEOVER\DMS-DER04-TAKEOVER\Premium ADO NET Destination 1.Outputs[Error Output]"
                      exclusionGroup="1"
                      isErrorOut="true"
                      name="Error Output"
                      synchronousInputId="Package\Sequence Container TAKEOVER\DMS-DER04-TAKEOVER\Premium ADO NET Destination 1.Inputs[Primary Input]">
                      <outputColumns>
                        <outputColumn
                          refId="Package\Sequence Container TAKEOVER\DMS-DER04-TAKEOVER\Premium ADO NET Destination 1.Outputs[Error Output].Columns[ErrorCode]"
                          dataType="i4"
                          lineageId="Package\Sequence Container TAKEOVER\DMS-DER04-TAKEOVER\Premium ADO NET Destination 1.Outputs[Error Output].Columns[ErrorCode]"
                          name="ErrorCode"
                          specialFlags="1" />
                        <outputColumn
                          refId="Package\Sequence Container TAKEOVER\DMS-DER04-TAKEOVER\Premium ADO NET Destination 1.Outputs[Error Output].Columns[ErrorColumn]"
                          dataType="i4"
                          lineageId="Package\Sequence Container TAKEOVER\DMS-DER04-TAKEOVER\Premium ADO NET Destination 1.Outputs[Error Output].Columns[ErrorColumn]"
                          name="ErrorColumn"
                          specialFlags="2" />
                        <outputColumn
                          refId="Package\Sequence Container TAKEOVER\DMS-DER04-TAKEOVER\Premium ADO NET Destination 1.Outputs[Error Output].Columns[ErrorMessage]"
                          dataType="wstr"
                          length="2048"
                          lineageId="Package\Sequence Container TAKEOVER\DMS-DER04-TAKEOVER\Premium ADO NET Destination 1.Outputs[Error Output].Columns[ErrorMessage]"
                          name="ErrorMessage" />
                      </outputColumns>
                      <externalMetadataColumns />
                    </output>
                    <output
                      refId="Package\Sequence Container TAKEOVER\DMS-DER04-TAKEOVER\Premium ADO NET Destination 1.Outputs[Default Output]"
                      exclusionGroup="1"
                      name="Default Output"
                      synchronousInputId="Package\Sequence Container TAKEOVER\DMS-DER04-TAKEOVER\Premium ADO NET Destination 1.Inputs[Primary Input]">
                      <externalMetadataColumns />
                    </output>
                  </outputs>
                </component>
                <component
                  refId="Package\Sequence Container TAKEOVER\DMS-DER04-TAKEOVER\Premium ADO NET Source 1"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="KingswaySoft Inc.; http://www.kingswaysoft.com; support@kingswaysoft.com; Copyright (c) 2011-2025 KingswaySoft Inc."
                  description="Read data from an ADO.NET connection."
                  name="Premium ADO NET Source 1"
                  usesDispositions="true"
                  version="2">
                  <properties>
                    <property
                      dataType="System.String"
                      expressionType="Notify"
                      name="DataSource">&lt;&lt;Custom Command&gt;&gt;</property>
                    <property
                      dataType="System.String"
                      expressionType="Notify"
                      name="Command">DECLARE @FE_MIGRACION DATE = '2025-07-03';

WITH BASE AS (
    SELECT *,
        COALESCE(
            NULLIF(CAST(CO_LINEA_CREDITO_ACTIVA AS VARCHAR), ''), 
            NULLIF(CAST(CO_PROYECTO AS VARCHAR), '')

        ) AS FACILITY
    FROM OPERACION_ACTIVA
    WHERE 
        FE_LINEA_TIEMPO = @FE_MIGRACION
        AND CO_PERSONA_FUENTE_RECURSO IS NOT NULL
),
NUMERADOS AS (
    SELECT 
        (SELECT PR.CO_APROBACION_CFS 
         FROM PROYECTO PR 
         WHERE PR.CO_PROYECTO = FACILITY 
         AND PR.FE_LINEA_TIEMPO = @FE_MIGRACION) AS PADRE_SUPERIOR,
        FACILITY,       
        CO_PROYECTO,        
        CO_OPERACION_ACTIVA,
        CO_PERSONA_FUENTE_RECURSO,
        NB_PERSONA_FUENTE_RECURSO,
        DE_STATUS_OPERACION,
        DE_INDICE_TASA_BASE_INTERES, 
        ROW_NUMBER() OVER (
            PARTITION BY CO_PROYECTO, FACILITY
            ORDER BY CO_OPERACION_ACTIVA
        ) AS HIJO_NUM,
        COUNT(*) OVER (
            PARTITION BY CO_PROYECTO, FACILITY
        ) AS TOTAL_HIJOS,
        MAX(CASE WHEN CO_PERSONA_FUENTE_RECURSO = 1508 THEN 1 ELSE 0 END) OVER (
            PARTITION BY CO_PROYECTO, FACILITY
        ) AS GRUPO_TIENE_1508,
        FE_CONTRATO,
        FE_VENCIMIENTO,
        FE_PROXIMO_COBRO_INTERES,
        FE_PROXIMO_COBRO_CAPITAL,
        (SELECT TOP 1 MAX(FE_CONTRATO) AS FECHA_MAXIMA FROM [datamart].[dbo].[operacion_pasiva] WHERE co_operacion_pasiva = CO_OPERACION_CMPNSCION) AS FE_CONTRATO_PASIVA,
        (SELECT TOP 1 MAX(FE_VENCIMIENTO) AS FECHA_MAXIMA FROM [datamart].[dbo].[operacion_pasiva] WHERE co_operacion_pasiva = CO_OPERACION_CMPNSCION) AS FE_VENCIMIENTO_PASIVA,
        CO_OPERACION_CMPNSCION,
        TA_CMPNSCION,
        TI_RIESGO_OPERACION_ACTIVA,
        FE_VENCIMIENTO_KFW,
        (SELECT MARGIN FROM [DBO].[PHOENIX_LN_ACCT_INT_OPT] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3)) AS [TOTAL_MARGEN],
        (SELECT MARGIN FROM [DBO].[PHOENIX_LN_ACCT_ALT_INT] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3) AND ALT_INT_ID = '4') AS 'MARGEN FFC',
        (SELECT STATUS FROM [DBO].[PHOENIX_LN_ACCT_ALT_INT] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3) AND ALT_INT_ID = '4') AS 'ESTADO FFC',
        (SELECT CURRENT_RATE FROM [DBO].[PHOENIX_LN_ACCT_ALT_INT] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3) AND ALT_INT_ID = '4') AS 'TASA FFC',
        (SELECT END_ACCR_DT FROM [DBO].[PHOENIX_LN_ACCT_ALT_INT] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3) AND ALT_INT_ID = '4') AS 'FE_VENCIMIENTO_FFC',
        (SELECT ACCR_BASIS FROM [DBO].[PHOENIX_LN_ACCT_INT_OPT] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3)) AS 'ACCR BASIS OPT',
        (SELECT ACCR_BASIS FROM [DBO].[PHOENIX_LN_ACCT_ALT_INT] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3) AND ALT_INT_ID = '4') AS 'ACCR BASIS ALT',
        MO_APROBADO_MONEDA_ORIGEN,
        (SELECT TOP 1 CUR_BAL FROM [dbo].[Phoenix_ln_disb_int] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3) AND STATUS = 'Active' ORDER BY EFFECTIVE_DT DESC ) AS [CUR_BAL_PHOENIX], --CREADO   
        (SELECT CASE WHEN COUNT(*) &gt;= 1 THEN 'BAND' ELSE NULL END FROM [dbo].[Phoenix_ln_disb_int] WHERE STATUS = 'Active' AND ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA))) AS [PRINCIPALINT.RATE.TIER.TYPE_PHOENIX],  --CREADO
        ISNULL((SELECT TOP 1 MARGIN FROM [dbo].[Phoenix_ln_disb_int] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3) AND STATUS = 'Active' ORDER BY EFFECTIVE_DT DESC), 0) AS [MARGIN_PHOENIX], --CREADO

        (SELECT TOP 1 NEW_RATE FROM [dbo].[Phoenix_gb_acct_rate] WHERE ACCT_NO = SUBSTRING(CO_OPERACION_ACTIVA, 4, LEN(CO_OPERACION_ACTIVA)) AND ACCT_TYPE = LEFT(CO_OPERACION_ACTIVA, 3)  ORDER BY EFFECTIVE_DT DESC ) AS [NEW_RATE_PHOENIX], --CREADO 
        
        (SELECT SUM(MO_MONEDA_ORIGEN) FROM DESEMBOLSO WHERE CO_OPERACION_ACTIVA = BA.CO_OPERACION_ACTIVA AND CO_TRANSACCION IN ('350','355') AND (
                BA.CO_PERSONA_FUENTE_RECURSO = 1508
                OR (BA.CO_PERSONA_FUENTE_RECURSO &lt;&gt; 1508 AND (DE_DESEMBOLSO NOT LIKE '%KFW%' OR DE_DESEMBOLSO IS NULL))
        )) AS 'TOTAL DESEMBOLSADO',
        MO_X_DESEMBOLSAR_ORIGEN,
        (SELECT SUM(MO_MONEDA_ORIGEN) FROM RECUPERACION WHERE CO_OPERACION_ACTIVA = BA.CO_OPERACION_ACTIVA AND CO_TRANSACCION IN ('300') AND TI_RECUPERACION = 'CAPITAL' AND (
                BA.CO_PERSONA_FUENTE_RECURSO = 1508
                OR (BA.CO_PERSONA_FUENTE_RECURSO &lt;&gt; 1508 AND (DE_RECUPERACION NOT LIKE '%KFW%' OR DE_RECUPERACION IS NULL))
        )) AS 'TOTAL RECUPERADO',

        SA_ACTUAL_MONEDA_ORIGEN,
        MO_INTERESES_X_COBRAR, 
        MO_INTERES_CMPNSCION_ACUM_X_COBRAR_ORGEN,
        MO_INTERES_VNCDO_X_COBRAR, 
        CO_PERSONA_PRESTATARIO,
        CO_STATUS_OPERACION_ACTIVA,  
        CO_GRUPO_PRODUCTO, 
        NB_GRUPO_PRODUCTO, 
        CO_OPERACION_PASIVA_RELACIONADA,
        @FE_MIGRACION AS FE_MIGRACION,      
        (SELECT SUM(mo_capital_moneda_origen) FROM amortizacion_plan_activa WHERE BA.CO_OPERACION_ACTIVA = co_operacion_activa) AS MO_CAPITAL_MONEDA_ORIGEN, --CREADO
        (SELECT SUM(mo_interes_usd) FROM amortizacion_plan_activa WHERE BA.CO_OPERACION_ACTIVA = co_operacion_activa) AS MO_INTERES_USD, --CREADO
        CASE WHEN ROW_NUMBER() OVER (PARTITION BY CO_PROYECTO, FACILITY ORDER BY CO_OPERACION_ACTIVA) = 1 THEN 'ORIGINAL' ELSE 'KFW' END AS CO_CONDICION, --CREADO
        (SELECT co_SWIFT_moneda FROM moneda WHERE moneda.co_moneda = CO_MONEDA_ORIGEN_OPERACION) AS CURRENCY --CREADO
    FROM BASE BA
)
SELECT
    A.PADRE_SUPERIOR,
    A.FACILITY,
    A.FE_CONTRATO,
    A.CO_OPERACION_ACTIVA,
    A.CO_PERSONA_FUENTE_RECURSO,
    A.NB_PERSONA_FUENTE_RECURSO,
    A.DE_STATUS_OPERACION,
    A.HIJO_NUM,
    A.CO_CONDICION,--AGREGADO
    --CASE WHEN A.HIJO_NUM = 1 THEN NULL ELSE PADRE.CO_OPERACION_ACTIVA END AS CO_OPERACION_ORIGINAL,
    A.FE_VENCIMIENTO,
    A.CO_OPERACION_CMPNSCION,
    A.TA_CMPNSCION,
    --A.TI_RIESGO_OPERACION_ACTIVA,
    A.FE_VENCIMIENTO_KFW,
    A.FE_MIGRACION,
    A.[TOTAL_MARGEN],           
    A.[MARGEN FFC] AS 'MARGEN_PHOENIX_KFW',
    ABS(A.[TOTAL_MARGEN] - B.[TOTAL_MARGEN]) AS ABARATAMIENTO,
    A.[ESTADO FFC],
    A.[TASA FFC],
    A.[FE_VENCIMIENTO_FFC],
    A.MO_APROBADO_MONEDA_ORIGEN,
    --A.[TOTAL DESEMBOLSADO] AS 'MO_TOTAL_DESEMBOLSADO_ORIGEN',
    A.MO_X_DESEMBOLSAR_ORIGEN,
    A.MO_CAPITAL_MONEDA_ORIGEN,
    --A.[TOTAL RECUPERADO] AS 'MO_TOTAL_RECUPERADO_ORIGEN', 
    --A.SA_ACTUAL_MONEDA_ORIGEN, 
    --A.MO_INTERESES_X_COBRAR, 
    --A.MO_INTERES_CMPNSCION_ACUM_X_COBRAR_ORGEN,
    --A.MO_INTERES_VNCDO_X_COBRAR, 
    A.MO_INTERES_USD,
    --A.CO_PERSONA_PRESTATARIO,
    A.CO_STATUS_OPERACION_ACTIVA, 
    --A.CO_GRUPO_PRODUCTO,
    --A.NB_GRUPO_PRODUCTO, 
    --A.CO_OPERACION_PASIVA_RELACIONADA,
    A.[ACCR BASIS OPT],
    A.[ACCR BASIS ALT], 
    A.NEW_RATE_PHOENIX,
    A.MARGIN_PHOENIX,
    A.CUR_BAL_PHOENIX,  

    ------------- DWCOMMITMENT.AMOUNT
    (
        SELECT 
                CASE WHEN A.CO_CONDICION IN ('KWF', 'FFC') THEN 0 ELSE CASE WHEN A.CURRENCY IN ('JPY', 'PYG') THEN CEILING(
                    CASE    WHEN SUM(TRY_CAST(N2.[TOTAL DESEMBOLSADO] AS decimal(18,2))) &gt; SUM(TRY_CAST(N2.mo_aprobado_moneda_origen AS decimal(18,2))) 
                            THEN SUM(TRY_CAST(N2.[TOTAL DESEMBOLSADO] AS decimal(18,2))) 
                            ELSE SUM(TRY_CAST(N2.mo_aprobado_moneda_origen AS decimal(18,2))) END)
                ELSE ROUND(CASE WHEN SUM(TRY_CAST(N2.[TOTAL DESEMBOLSADO] AS decimal(18,2))) &gt; SUM(TRY_CAST(N2.mo_aprobado_moneda_origen AS decimal(18,2))) 
                            THEN SUM(TRY_CAST(N2.[TOTAL DESEMBOLSADO] AS decimal(18,2))) 
                            ELSE SUM(TRY_CAST(N2.mo_aprobado_moneda_origen AS decimal(18,2))) END, 2) END
                END
        FROM NUMERADOS N2
        WHERE A.CO_CONDICION = 'ORIGINAL' AND N2.FACILITY = A.FACILITY
        HAVING 
            SUM(TRY_CAST(N2.mo_aprobado_moneda_origen AS decimal(18,2))) &gt; 0
    ) AS [FV.DWCOMMITMENT.AMOUNT],

   ------------------------------ [FNQ.INTERESTFFC.FIXED.RATE]
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN  CASE  WHEN A.TA_CMPNSCION IS NOT NULL AND A.TA_CMPNSCION &lt;&gt; 0 AND A.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION 
                THEN CONVERT(VARCHAR(50), A.TA_CMPNSCION) ELSE '' END ELSE '' END) AS [INTERESTFFC_FIXED_RATE],     

    ------------------------------ [FV.INTERESTFFC.DAY.BASIS]
    (
    CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN ISNULL((SELECT N2.[ACCR BASIS ALT] FROM NUMERADOS N2 LEFT JOIN NUMERADOS PADRE2 ON N2.FACILITY = PADRE2.FACILITY AND PADRE2.HIJO_NUM = 1      
    WHERE  A.TOTAL_HIJOS &gt;= 2 AND N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION GROUP BY N2.[ACCR BASIS ALT]), '')
        ELSE ''
        END 
    ) AS [INTERESTFFC.DAY.BASIS],

    ------------------------------ [FV.INTERESTKWF.DAY.BASIS]
     (
       CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN ISNULL((SELECT N2.[ACCR BASIS ALT] FROM NUMERADOS N2 LEFT JOIN NUMERADOS PADRE2 ON N2.FACILITY = PADRE2.FACILITY AND N2.CO_PROYECTO = PADRE2.CO_PROYECTO AND PADRE2.HIJO_NUM = 1      
            WHERE  A.TOTAL_HIJOS &gt;= 2 AND N2.GRUPO_TIENE_1508 = 1 AND N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION), '')
        ELSE ''
    END 
    ) AS [FV.INTERESTKWF.DAY.BASIS],

    ------------------------------ [FV.INTERESTKFW.FIXED.RATE]    
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN (SELECT CASE WHEN SUM(ABS(PADRE2.TOTAL_MARGEN - N2.TOTAL_MARGEN)) &gt; 0 THEN CONVERT(VARCHAR, SUM(ABS(PADRE2.TOTAL_MARGEN - N2.TOTAL_MARGEN)))
                    ELSE '' END
            FROM NUMERADOS N2 LEFT JOIN NUMERADOS PADRE2 ON N2.FACILITY = PADRE2.FACILITY AND PADRE2.HIJO_NUM = 1   
            WHERE A.TOTAL_HIJOS &gt;= 2 AND N2.GRUPO_TIENE_1508 = 1 AND N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION)  ELSE '' END
    ) AS [FV.INTERESTKFW.FIXED.RATE],

     ------------------------------ [FV.INTVENCIDOB.DAY.BASIS]    
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN ISNULL((SELECT N2.[ACCR BASIS ALT] FROM NUMERADOS N2 LEFT JOIN NUMERADOS PADRE2 ON N2.FACILITY = PADRE2.FACILITY AND PADRE2.HIJO_NUM = 1      
         WHERE  A.TOTAL_HIJOS &gt;= 2 AND N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION AND A.CO_STATUS_OPERACION_ACTIVA = 14 GROUP BY N2.[ACCR BASIS ALT]), '')
        ELSE ''
        END 
    ) AS [INTVENCIDOB.DAY.BASIS],

    ------------------------------ [FV.INTVENCIDOB.RATE.TIER.TYPE] 

    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN  ISNULL((SELECT TOP 1 'BAND' FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.CO_STATUS_OPERACION_ACTIVA = 14 AND A.TOTAL_HIJOS &gt;= 2), '')
        ELSE ''
    END) AS [INTVENCIDOB.RATE.TIER.TYPE],  

    ------------------------------ [FV.INTVENCIDOB.FIXED.RATE] 
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' AND A.CO_STATUS_OPERACION_ACTIVA = 14 THEN (SELECT CONVERT(VARCHAR, 
                CASE WHEN EXISTS (SELECT 1 FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION) 
                    THEN (SELECT SUM(ABS(N2.MARGIN_PHOENIX + N2.ta_cmpnscion + N2.[MARGEN FFC])) FROM NUMERADOS N2 WHERE N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION)
                    WHEN EXISTS (SELECT 1 FROM NUMERADOS N2 WHERE N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION) 
                    THEN (SELECT SUM(ABS(N2.MARGIN_PHOENIX + N2.ta_cmpnscion + N2.[MARGEN FFC])) FROM NUMERADOS N2 WHERE N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION)
                    ELSE 0 END))
        ELSE '' 
    END) AS [INTVENCIDOB.FIXED.RATE],

    (CASE 
        WHEN A.CO_CONDICION = 'ORIGINAL' AND A.CO_STATUS_OPERACION_ACTIVA = 14 THEN 'FIXED.RATE:1:1' + -- valor base del padre
            ISNULL((SELECT STRING_AGG('!!FIXED.RATE:' + CONVERT(VARCHAR(5), RN.Position + 1) + ':1', '') FROM (SELECT ROW_NUMBER() OVER (ORDER BY NX.HIJO_NUM) AS Position FROM NUMERADOS NX WHERE NX.FACILITY = A.FACILITY AND NX.HIJO_NUM &gt; 1 AND NX.CO_STATUS_OPERACION_ACTIVA = 14) RN), '') +
            '!!FIXED.RATE:' +  CONVERT(VARCHAR(5), (SELECT COUNT(*) + 1 FROM NUMERADOS NX WHERE NX.FACILITY = A.FACILITY AND NX.CO_STATUS_OPERACION_ACTIVA = 14)) + ':1'
        ELSE 'FIXED.RATE:1:1' END
    )AS [FNQ.INTVENCIDOB.FIXED.RATE], 

    ------------------------------ [FV.INTVENCIDOB.MARGIN.TYPE] 
     (CASE WHEN A.CO_CONDICION = 'ORIGINAL' AND A.CO_STATUS_OPERACION_ACTIVA = 14 THEN ISNULL((SELECT STRING_AGG(
                CASE WHEN N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION THEN '!!SINGLE!!KWF' 
                     WHEN N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION THEN 'SINGLE!!FFC' ELSE '' END, '')
                    FROM NUMERADOS N2 WHERE N2.CO_STATUS_OPERACION_ACTIVA = 14 AND  N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 ), '') 
                    + CASE WHEN A.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION THEN '!!SINGLE!!FFC' ELSE '' END + '!!!!'
            ELSE '' 
                    + CASE WHEN A.CO_STATUS_OPERACION_ACTIVA = 14 AND A.CO_CONDICION = 'KFW' AND A.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION THEN 'KWF' 
                    WHEN A.CO_STATUS_OPERACION_ACTIVA = 14 AND A.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION THEN 'FFC' ELSE '' END
        END
    ) AS [INTVENCIDOB.MARGIN.TYPE],    
    (
        CASE 
            WHEN A.CO_STATUS_OPERACION_ACTIVA = 14 AND A.CO_CONDICION = 'ORIGINAL' THEN 'MARGIN.TYPE:1:1' + -- Banda del padre
                ISNULL((SELECT STRING_AGG('!!MARGIN.TYPE:' + CAST(B.Posicion AS VARCHAR) + ':1!!MARGIN.TYPE:' + CAST(B.Posicion AS VARCHAR) + ':2', '') 
                        FROM (SELECT ROW_NUMBER() OVER (ORDER BY N2.HIJO_NUM) + 1 AS Posicion FROM NUMERADOS N2 WHERE N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.FACILITY = A.FACILITY 
                        AND ((N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION) OR (N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION))) AS B), '')  ELSE   '' END
    ) AS [FNQ.INTVENCIDOB.MARGIN.TYPE],

    ------------------------------ [FV.INTVENCIDOB.MARGIN.OPER]     
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' AND A.CO_STATUS_OPERACION_ACTIVA = 14 THEN 'ADD' + ISNULL((SELECT STRING_AGG(
                CASE WHEN N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION THEN '!!ADD!!SUB' 
                     WHEN N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION THEN '!!ADD!!SUB' ELSE '' END, '')
                    FROM NUMERADOS N2 WHERE N2.CO_STATUS_OPERACION_ACTIVA = 14 AND  N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 ), '') 
                    + CASE WHEN A.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION THEN '!!ADD!!SUB'  ELSE '' END + '!!!!'
            ELSE ''                     
        END
    ) AS [INTVENCIDOB.MARGIN.OPER],
    
    (CASE WHEN A.CO_STATUS_OPERACION_ACTIVA = 14 AND A.CO_CONDICION = 'ORIGINAL' THEN 'MARGIN.OPER:1:1' + -- Banda inicial (ORIGINAL): 1:1
                -- Por cada hijo, agregar: !!N:1!!N:2
                ISNULL((SELECT STRING_AGG('!!MARGIN.OPER:' + CONVERT(VARCHAR(5), RN.Position + 1) + ':1!!MARGIN.OPER:' + CONVERT(VARCHAR(5), RN.Position + 1) + ':2', '')
                    FROM (SELECT ROW_NUMBER() OVER (ORDER BY N2.HIJO_NUM) AS Position FROM NUMERADOS N2 WHERE N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1) RN), '') +
                -- Banda final adicional: N+1:1 y N+1:2
                (SELECT '!!MARGIN.OPER:' + CONVERT(VARCHAR(5), COUNT(*) + 1) + ':1!!MARGIN.OPER:' + CONVERT(VARCHAR(5), COUNT(*) + 1) + ':2' FROM  NUMERADOS N2 WHERE N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.FACILITY = A.FACILITY)
            ELSE '' END
    ) AS [FNQ.INTVENCIDOB.MARGIN.OPER],

    ------------------------------ [FV.INTVENCIDOB.MARGIN.RATE] 
     (        CASE WHEN A.CO_STATUS_OPERACION_ACTIVA = 14 AND A.CO_CONDICION = 'ORIGINAL' THEN -- Banda del padre: Phoenix Margin y ta_cmpnscion

                CONVERT(VARCHAR(50), ISNULL(A.MARGIN_PHOENIX, 0)) +  --CONVERT(VARCHAR(50), ISNULL(A.TA_CMPNSCION, 0)) + -- Por cada hijo, construir valores en una subconsulta precalculada
                ISNULL((SELECT STRING_AGG('!!' + CONVERT(VARCHAR(50), ISNULL(NX.TOTAL_MARGEN, 0)) + '!!' + CONVERT(VARCHAR(50), ISNULL(NX.TA_KFW, 0)), '')
                    FROM (SELECT N2.TOTAL_MARGEN, TA_KFW = ABS(ISNULL(PADRE2.TOTAL_MARGEN, 0) - ISNULL(N2.TOTAL_MARGEN, 0)) 

                    FROM NUMERADOS N2 LEFT JOIN NUMERADOS PADRE2 ON N2.FACILITY = PADRE2.FACILITY AND PADRE2.HIJO_NUM = 1

                    WHERE N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND (N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION OR N2.FE_VENCIMIENTO_KFW IS NULL)) NX), '') +  -- Banda vacía adicional
                '!!' + '' + '!!' + ''   ELSE '' END
    ) AS [FV.INTVENCIDOB.MARGIN.RATE],

    (CASE WHEN A.CO_STATUS_OPERACION_ACTIVA = 14 AND A.CO_CONDICION = 'ORIGINAL' THEN 'MARGIN.RATE:1:1' + -- Banda inicial
                -- Por cada hijo (HIJO_NUM &gt; 1), genera bandas intermedias
                ISNULL((SELECT STRING_AGG('!!MARGIN.RATE:' + CONVERT(VARCHAR(5), RN.Position + 1) + ':1!!MARGIN.RATE:' + CONVERT(VARCHAR(5), RN.Position + 1) + ':2', '')
                    FROM (SELECT ROW_NUMBER() OVER (ORDER BY N2.HIJO_NUM) AS Position
                        FROM NUMERADOS N2
                        WHERE N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND (N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION OR N2.FE_VENCIMIENTO_KFW IS NULL)
                    ) RN
                ), '') +
                -- Agrega banda adicional vacía: N+1:1 y N+1:2
                (SELECT '!!MARGIN.RATE:' + CONVERT(VARCHAR(5), COUNT(*) + 1) + ':1!!MARGIN.RATE:' + CONVERT(VARCHAR(5), COUNT(*) + 1) + ':2' FROM NUMERADOS N3 WHERE N3.CO_STATUS_OPERACION_ACTIVA = 14 AND N3.FACILITY = A.FACILITY)
            ELSE '' 
        END
    ) AS [FNQ.INTVENCIDOB.MARGIN.RATE],


    ------------------------------ [FV.INTVENCIDOB.TIER.AMOUNT] 
    (CASE WHEN A.CO_STATUS_OPERACION_ACTIVA = 14 AND A.CO_CONDICION = 'ORIGINAL' THEN (
        SELECT STRING_AGG(SumaFormateada, '!!') + '!!' + CASE WHEN A.CURRENCY IN ('JPY', 'PYG', 'CLP') THEN '0' ELSE '0.00' END
        FROM (SELECT FORMAT(SUM(CUR_BAL_PHOENIX) OVER (PARTITION BY FACILITY ORDER BY (SELECT NULL) ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), 
                    CASE WHEN A.CURRENCY IN ('JPY', 'PYG', 'CLP') THEN '0' ELSE '0.00' END, 'en-US') AS SumaFormateada
            FROM NUMERADOS N2 
            WHERE N2.CO_STATUS_OPERACION_ACTIVA = 14 
              AND N2.FACILITY = A.FACILITY
            ) AS Acumulado
        )ELSE '' END
    ) AS [INTVENCIDOB.TIER.AMOUNT],

    (CASE WHEN A.CO_STATUS_OPERACION_ACTIVA = 14 AND A.CO_CONDICION = 'ORIGINAL' THEN (SELECT STRING_AGG('TIER.AMOUNT:' + CAST(Num AS VARCHAR) + ':1', '!!') FROM (SELECT ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS Num 
            FROM (SELECT 1 AS Val
                    UNION ALL SELECT 1 FROM NUMERADOS N2 WHERE N2.CO_STATUS_OPERACION_ACTIVA = 14 AND N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1
                    UNION ALL SELECT 1) AS Conteo) AS Numerados) ELSE ''END
    ) AS [FNQ.INTVENCIDOB.TIER.AMOUNT], 

    ------------------------------ [FV.INTVENCIDOB.L.MARGIN]
    --(CASE WHEN A.CO_STATUS_OPERACION_ACTIVA = 14 AND A.CO_CONDICION = 'ORIGINAL' THEN STRING_AGG(FORMAT(A.TOTAL_MARGEN, '0.00', 'en-US'), '!!') ELSE '' END) AS [INTVENCIDOB.L.MARGIN],

    ------------------------------ [FV.INTVENCIDOB.L.PERIOD.INDEX] 
    (CASE WHEN A.CO_STATUS_OPERACION_ACTIVA = 14 AND A.CO_CONDICION = 'ORIGINAL' THEN RTRIM(LTRIM(A.DE_INDICE_TASA_BASE_INTERES)) ELSE ''END) AS [INTVENCIDOB.L.PERIOD.INDEX],

    ------------------------------ [PENALINTB.DAY.BASIS]
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN ISNULL((SELECT N2.[ACCR BASIS ALT] FROM NUMERADOS N2 LEFT JOIN NUMERADOS PADRE2 ON N2.FACILITY = PADRE2.FACILITY AND PADRE2.HIJO_NUM = 1      
         WHERE  A.TOTAL_HIJOS &gt;= 2 AND N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION AND A.CO_STATUS_OPERACION_ACTIVA = 14 GROUP BY N2.[ACCR BASIS ALT]), '')
        ELSE ''
        END 
    ) AS [PENALINTB.DAY.BASIS],
    
    ------------------------------ [FNQ.PRINCIPALINT.FIXED.RATE]
    (
        CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN  CONVERT(VARCHAR(50), ABS(A.NEW_RATE_PHOENIX - A.MARGIN_PHOENIX)) -- Primer valor (el de A)
                + ISNULL((SELECT STRING_AGG('!!' + CONVERT(VARCHAR(50), ABS(NX.NEW_RATE_PHOENIX - NX.MARGIN_PHOENIX)), '') FROM NUMERADOS NX WHERE NX.FACILITY = A.FACILITY AND NX.HIJO_NUM &gt; 1), '')-- Concatenar hijos adicionales si existen
                + '!!0.00'-- Siempre cerrar con !!0.00
            ELSE '0.00'
        END
    ) AS [FV_PRINCIPALINT_FIXED_RATE],

   (
    CASE 
        WHEN A.CO_CONDICION = 'ORIGINAL' THEN 'FIXED.RATE:1:1' + -- valor base del padre
            ISNULL((SELECT STRING_AGG('!!FIXED.RATE:' + CONVERT(VARCHAR(5), RN.Position + 1) + ':1', '') FROM (SELECT ROW_NUMBER() OVER (ORDER BY NX.HIJO_NUM) AS Position FROM NUMERADOS NX WHERE NX.FACILITY = A.FACILITY AND NX.HIJO_NUM &gt; 1) RN), '') +
            '!!FIXED.RATE:' +  CONVERT(VARCHAR(5), (SELECT COUNT(*) + 1 FROM NUMERADOS NX WHERE NX.FACILITY = A.FACILITY)) + ':1'
        ELSE 'FIXED.RATE:1:1'
    END
    )AS [FNQ.PRINCIPALINT.FIXED.RATE], 
    
     RTRIM(LTRIM(A.DE_INDICE_TASA_BASE_INTERES)) AS FV_PRINCIPALINT_PERIODIC_INDEX,-- [PRINCIPALINT_PERIODIC_INDEX]
    
    A.[PRINCIPALINT.RATE.TIER.TYPE_PHOENIX] AS [FV.PRINCIPALINT.RATE.TIER.TYPE],
    
    
    ------------------------------ [PRINCIPALINT.MARGIN.TYPE]
   (
        CASE 
            WHEN A.CO_CONDICION = 'ORIGINAL' THEN 
                -- Inicia con SINGLE
                'SINGLE' + ISNULL((SELECT STRING_AGG(CASE WHEN N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION THEN '!!SINGLE!!KWF' WHEN N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION THEN 'SINGLE!!FFC'
                            ELSE '' END, '')
                    FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND N2.CO_CONDICION IN ('KFW') ), '') 
                    + CASE WHEN A.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION THEN '!!SINGLE!!FFC' ELSE '' END + '!!!!'
            ELSE '' 
                    + CASE WHEN A.CO_CONDICION = 'KFW' AND A.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION THEN 'KWF' WHEN A.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION THEN 'FFC' ELSE '' END
        END
    ) AS [PRINCIPALINT.MARGIN.TYPE],    
    (
        CASE 
            WHEN A.CO_CONDICION = 'ORIGINAL' THEN 'MARGIN.TYPE:1:1' + -- Banda del padre
                ISNULL((SELECT STRING_AGG('!!MARGIN.TYPE:' + CAST(B.Posicion AS VARCHAR) + ':1!!MARGIN.TYPE:' + CAST(B.Posicion AS VARCHAR) + ':2', '') 
                        FROM (SELECT ROW_NUMBER() OVER (ORDER BY N2.HIJO_NUM) + 1 AS Posicion FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY 
                        AND ((N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION) OR (N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION))) AS B), '')  ELSE   '' END
    ) AS [FNQ.PRINCIPALINT.MARGIN.TYPE],
    
    ------------------------------ [PRINCIPALINT.MARGIN.OPER]
   (
        CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN 'ADD' + -- Banda del padre
            -- Por cada hijo: !!ADD!!SUB
            ISNULL((SELECT STRING_AGG('!!ADD!!SUB', '') FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1), '') + '!!!!'-- Banda vacía final
        ELSE 
            -- Si es hijo individual
            'ADD'
        END
    ) AS [PRINCIPALINT.MARGIN.OPER],
    
    (
        CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN 'MARGIN.OPER:1:1' + -- Banda inicial (ORIGINAL): 1:1
                -- Por cada hijo, agregar: !!N:1!!N:2
                ISNULL((SELECT STRING_AGG('!!MARGIN.OPER:' + CONVERT(VARCHAR(5), RN.Position + 1) + ':1!!MARGIN.OPER:' + CONVERT(VARCHAR(5), RN.Position + 1) + ':2', '')
                    FROM (SELECT ROW_NUMBER() OVER (ORDER BY N2.HIJO_NUM) AS Position FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1) RN), '') +
                -- Banda final adicional: N+1:1 y N+1:2
                (SELECT '!!MARGIN.OPER:' + CONVERT(VARCHAR(5), COUNT(*) + 1) + ':1!!MARGIN.OPER:' + CONVERT(VARCHAR(5), COUNT(*) + 1) + ':2' FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY)
            ELSE 
                -- Si no es el padre, es un hijo suelto
                'MARGIN.OPER:' + CONVERT(VARCHAR(5), A.HIJO_NUM) + ':2'
        END
    ) AS [FNQ.PRINCIPALINT.MARGIN.OPER],
    
     ------------------------------ [PRINCIPALINT.MARGIN.RATE]
   (
        CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN -- Banda del padre: Phoenix Margin y ta_cmpnscion

                CONVERT(VARCHAR(50), ISNULL(A.MARGIN_PHOENIX, 0)) +  --CONVERT(VARCHAR(50), ISNULL(A.TA_CMPNSCION, 0)) + -- Por cada hijo, construir valores en una subconsulta precalculada
                ISNULL((SELECT STRING_AGG('!!' + CONVERT(VARCHAR(50), ISNULL(NX.TOTAL_MARGEN, 0)) + '!!' + CONVERT(VARCHAR(50), ISNULL(NX.TA_KFW, 0)), '')
                    FROM (SELECT N2.TOTAL_MARGEN, TA_KFW = ABS(ISNULL(PADRE2.TOTAL_MARGEN, 0) - ISNULL(N2.TOTAL_MARGEN, 0)) 

                    FROM NUMERADOS N2 LEFT JOIN NUMERADOS PADRE2 ON N2.FACILITY = PADRE2.FACILITY AND PADRE2.HIJO_NUM = 1

                    WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND (N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION OR N2.FE_VENCIMIENTO_KFW IS NULL)) NX), '') +  -- Banda vacía adicional
                '!!' + '' + '!!' + ''
            ELSE 
                -- Si es hijo individual
               ''
        END
    ) AS [FV.PRINCIPALINT.MARGIN.RATE],
    (
        CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN 'MARGIN.RATE:1:1' + -- Banda inicial
                -- Por cada hijo (HIJO_NUM &gt; 1), genera bandas intermedias
                ISNULL((SELECT STRING_AGG('!!MARGIN.RATE:' + CONVERT(VARCHAR(5), RN.Position + 1) + ':1!!MARGIN.RATE:' + CONVERT(VARCHAR(5), RN.Position + 1) + ':2', '')
                    FROM (SELECT ROW_NUMBER() OVER (ORDER BY N2.HIJO_NUM) AS Position
                        FROM NUMERADOS N2
                        WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND (N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION OR N2.FE_VENCIMIENTO_KFW IS NULL)
                    ) RN
                ), '') +
                -- Agrega banda adicional vacía: N+1:1 y N+1:2
                (SELECT '!!MARGIN.RATE:' + CONVERT(VARCHAR(5), COUNT(*) + 1) + ':1!!MARGIN.RATE:' + CONVERT(VARCHAR(5), COUNT(*) + 1) + ':2' FROM NUMERADOS N3 WHERE N3.FACILITY = A.FACILITY)
            ELSE '' 
        END
    ) AS [FNQ.PRINCIPALINT.MARGIN.RATE],
    
     ------------------------------ [PRINCIPALINT.TIER.AMOUNT]- Hacer sumatoria de los anteriores
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN (SELECT STRING_AGG(SumaFormateada, '!!') + '!!' + 
                CASE WHEN A.CURRENCY IN ('JPY', 'PYG', 'CLP') THEN '0' ELSE '0.00' END
            FROM (SELECT FORMAT(SUM(CUR_BAL_PHOENIX) OVER (PARTITION BY FACILITY ORDER BY (SELECT NULL) ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),
                        CASE WHEN A.CURRENCY IN ('JPY', 'PYG', 'CLP') THEN '0' ELSE '0.00' END, 'en-US') AS SumaFormateada
                FROM NUMERADOS N2 
                WHERE N2.FACILITY = A.FACILITY
            ) AS Acumulado) ELSE '' END
    ) AS [PRINCIPALINT.TIER.AMOUNT],

    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN (SELECT STRING_AGG('TIER.AMOUNT:' + CAST(Num AS VARCHAR) + ':1', '!!') FROM (SELECT ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS Num 
            FROM (SELECT 1 AS Val
                    UNION ALL SELECT 1 FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1
                    UNION ALL SELECT 1) AS Conteo) AS Numerados) ELSE ''END
    ) AS [FNQ.PRINCIPALINT.TIER.AMOUNT],

   ------------------------------ [SCHEDULE.PROPERTY]
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN (SELECT 
            CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN 'ACCOUNT'
                + CASE WHEN EXISTS (SELECT 1 FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION) THEN '!!INTERESTFFC' ELSE '' END
                + CASE WHEN EXISTS (SELECT 1 FROM (SELECT SUM(N2.MO_INTERES_USD) AS Suma FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY) AS Sub WHERE Sub.Suma &gt; 0) THEN '!!PRINCIPALINT' ELSE '' END
                + CASE WHEN EXISTS (SELECT 1 FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION) THEN '!!INTERESTKWF' ELSE '' END
            ELSE 'ACCOUNT'END)
            ELSE '' END
    ) AS FV_SCHEDULE_PROPERTY,
    
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN (
        SELECT STRING_AGG('PROPERTY:' + CAST(Num AS VARCHAR) + ':1', '!!')
        FROM (SELECT ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS Num FROM (
                SELECT 1 AS Orden FROM NUMERADOS N2 WHERE A.CO_CONDICION = 'ORIGINAL' AND N2.FACILITY = A.FACILITY AND N2.HIJO_NUM = 1
                UNION ALL
                SELECT 1 FROM NUMERADOS N2 WHERE A.CO_CONDICION = 'ORIGINAL' AND N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
                UNION ALL
                SELECT 1 FROM (SELECT SUM(N2.MO_INTERES_USD) AS Suma FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY) AS Sub WHERE Sub.Suma &gt; 0
                UNION ALL
                SELECT 1 FROM NUMERADOS N2 WHERE A.CO_CONDICION = 'ORIGINAL' AND N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION GROUP BY N2.CO_CONDICION              
            ) AS CondicionesCumplidas
        ) AS Numerados)
        ELSE '' END
    ) AS [FNQ.SCHEDULE.PROPERTY],

     ------------------------------ [SCHEDULE.PAYMENT.METHOD]
    (   SELECT CASE WHEN A.HIJO_NUM = 1 AND A.CO_CONDICION = 'ORIGINAL' THEN 'DUE' 
            + CASE WHEN EXISTS (SELECT 1 FROM (SELECT COUNT(*) AS Total, COUNT(DISTINCT N2.MO_INTERES_USD) AS Distintos FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND N2.MO_APROBADO_MONEDA_ORIGEN = N2.MO_X_DESEMBOLSAR_ORIGEN
            ) AS Conteos WHERE Total = Distintos) THEN '!!DUE' ELSE '' END 
            + CASE WHEN EXISTS (SELECT 1 FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION) THEN '!!DUE' ELSE '' END 
            + CASE WHEN EXISTS (SELECT 1 FROM NUMERADOS N2  WHERE A.CO_CONDICION = 'ORIGINAL' AND N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' GROUP BY N2.CO_CONDICION) THEN '!!DUE' ELSE '' END           
        ELSE '' 
        END 
    ) AS [FV.SCHEDULE.PAYMENT.METHOD],
    
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN (SELECT STRING_AGG('PAYMENT.METHOD:' + CAST(Num AS VARCHAR) + ':1', '!!')
        FROM (SELECT ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS Num FROM (
                SELECT 1 AS Resultado FROM (SELECT SUM(N2.MO_CAPITAL_MONEDA_ORIGEN) AS Suma FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY) AS Sub WHERE Sub.Suma &gt; 0 
                UNION ALL               
                SELECT 1 AS Resultado FROM (SELECT COUNT(*) AS Total, COUNT(DISTINCT N2.MO_INTERES_USD) AS Distintos FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND N2.MO_APROBADO_MONEDA_ORIGEN = N2.MO_X_DESEMBOLSAR_ORIGEN AND N2.CO_CONDICION &lt;&gt; 'KFW') AS Conteos WHERE Total = Distintos
                UNION ALL
                SELECT 1 AS Resultado FROM NUMERADOS N2 WHERE A.CO_CONDICION = 'ORIGINAL' AND N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
                UNION ALL                
                SELECT 1 AS Resultado FROM NUMERADOS N2 WHERE A.CO_CONDICION = 'ORIGINAL' AND N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' GROUP BY N2.CO_CONDICION              
            ) AS CondicionesCumplidas
        ) AS Numerados
        ) ELSE '' END  
    ) AS [FNQ.SCHEDULE.PAYMENT.METHOD],
    
     ------------------------------ [SCHEDULE.PAYMENT.TYPE]
    (
        SELECT
        CASE 
        WHEN A.HIJO_NUM = 1 AND A.CO_CONDICION = 'ORIGINAL' THEN 'SPECIAL' 
            + CASE WHEN EXISTS (SELECT 1 FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND N2.MO_X_DESEMBOLSAR_ORIGEN = 0 AND N2.CO_CONDICION &lt;&gt; 'KFW') THEN '!!SPECIAL' ELSE '' END 
            + CASE WHEN EXISTS (SELECT 1 FROM (SELECT COUNT(*) AS Total, COUNT(DISTINCT N2.MO_INTERES_USD) AS Distintos FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 
                AND N2.MO_APROBADO_MONEDA_ORIGEN = N2.MO_X_DESEMBOLSAR_ORIGEN) AS Conteos WHERE Total = Distintos) THEN '!!INTEREST.ONLY' ELSE '' END 
            + CASE WHEN EXISTS (SELECT 1 FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND N2.MO_APROBADO_MONEDA_ORIGEN &gt; N2.MO_X_DESEMBOLSAR_ORIGEN AND N2.MO_X_DESEMBOLSAR_ORIGEN &gt; 0 AND N2.CO_CONDICION &lt;&gt; 'KFW') THEN '!!LINEAR' ELSE '' END 
            + CASE WHEN EXISTS (SELECT 1 FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND N2.MO_APROBADO_MONEDA_ORIGEN = N2.MO_X_DESEMBOLSAR_ORIGEN AND N2.CO_CONDICION &lt;&gt; 'KFW') THEN '!!LINEAR' ELSE '' END 
            + CASE WHEN EXISTS (SELECT 1 FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM = 2 AND N2.CO_CONDICION = 'KFW') THEN '!!FUND.PAYMT' ELSE '' END 
        ELSE 'FUND.PAYMT' 
        END 
    ) AS [SCHEDULE.PAYMENT.TYPE],

     (  SELECT STRING_AGG('PAYMENT.TYPE:' + CAST(Num AS VARCHAR) + ':1', '!!')
        FROM (SELECT ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS Num FROM (   
        -- Banda 1: Si es el padre original
            SELECT 1 AS Orden FROM NUMERADOS N2 WHERE A.CO_CONDICION = 'ORIGINAL' AND N2.FACILITY = A.FACILITY AND N2.HIJO_NUM = 1
            UNION ALL           -- Banda 2: Si todos los montos son diferentes
            SELECT 1 FROM (SELECT COUNT(*) AS Total, COUNT(DISTINCT N2.MO_INTERES_USD) AS Distintos FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND N2.MO_APROBADO_MONEDA_ORIGEN = N2.MO_X_DESEMBOLSAR_ORIGEN
            ) AS Conteos WHERE Total = Distintos
            UNION ALL           -- Banda 3: Aprobado &gt; Desembolsado y no es KFW
            SELECT 1 FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND N2.MO_APROBADO_MONEDA_ORIGEN &gt; N2.MO_X_DESEMBOLSAR_ORIGEN AND N2.MO_X_DESEMBOLSAR_ORIGEN &gt; 0 AND N2.CO_CONDICION &lt;&gt; 'KFW'
            UNION ALL           -- Banda 4: Aprobado = Desembolsado y no es KFW
            SELECT 1 FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND N2.MO_APROBADO_MONEDA_ORIGEN = N2.MO_X_DESEMBOLSAR_ORIGEN AND N2.CO_CONDICION &lt;&gt; 'KFW'
            UNION ALL           -- Banda 5: KFW presente
            SELECT 1 FROM NUMERADOS N2  WHERE A.CO_CONDICION = 'ORIGINAL' AND N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' GROUP BY N2.CO_CONDICION
        ) AS CondicionesCumplidas
        ) AS Numerados
    ) AS [FNQ.SCHEDULE.PAYMENT.TYPE],
    
    ------------------------------ [SCHEDULE.START.DATE]
   (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN (SELECT STRING_AGG(FORMAT(CONVERT(date, fe_vencimiento_cuota, 103), 'yyyyMMdd'), '!!') FROM [datamart].[dbo].[amortizacion_plan_activa] APA 
                                                WHERE EXISTS (SELECT 1 FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.CO_OPERACION_ACTIVA = APA.co_operacion_activa) AND fe_vencimiento_cuota &gt; @FE_MIGRACION)
        ELSE '' END) AS [SCHEDULE.START.DATE],
    
    
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN (SELECT STRING_AGG('START.DATE:' + CAST(OperacionNum AS VARCHAR) + ':' + CAST(FechaNum AS VARCHAR), '!!') 
    FROM (SELECT DENSE_RANK() OVER (PARTITION BY N2.FACILITY ORDER BY N2.CO_OPERACION_ACTIVA) AS OperacionNum, ROW_NUMBER() OVER (PARTITION BY N2.CO_OPERACION_ACTIVA ORDER BY APA.fe_vencimiento_cuota) AS FechaNum
    FROM NUMERADOS N2 JOIN [datamart].[dbo].[amortizacion_plan_activa] APA ON APA.co_operacion_activa = N2.CO_OPERACION_ACTIVA WHERE N2.FACILITY = A.FACILITY AND APA.fe_vencimiento_cuota &gt; @FE_MIGRACION) AS FechasNumeradas) 
    ELSE '' END) AS [FNQ.SCHEDULE.START.DATE],
    
     ------------------------------ [SCHEDULE.ACTUAL.AMT]     
   (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN (SELECT STRING_AGG(ValorFormateado, '!!') FROM (SELECT FORMAT(mo_capital_moneda_origen, CASE WHEN A.CURRENCY IN ('JPY', 'PYG', 'CLP') THEN '0' ELSE '0.00' END, 'en-US') AS ValorFormateado
                FROM [datamart].[dbo].[amortizacion_plan_activa] APA 
                WHERE EXISTS (SELECT 1 FROM NUMERADOS N2 WHERE N2.CO_CONDICION = 'ORIGINAL' AND N2.FACILITY = A.FACILITY AND N2.CO_OPERACION_ACTIVA = APA.co_operacion_activa) AND APA.fe_vencimiento_cuota &gt; @FE_MIGRACION) AS FormatoInterno
        )  ELSE '' END
    ) AS [SCHEDULE.ACTUAL.AMT],
        
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN (SELECT STRING_AGG('ACTUAL.AMT:' + CAST(OperacionNum AS VARCHAR) + ':' + CAST(FechaNum AS VARCHAR), '!!') 
    FROM (SELECT DENSE_RANK() OVER (PARTITION BY N2.FACILITY ORDER BY N2.CO_OPERACION_ACTIVA) AS OperacionNum, ROW_NUMBER() OVER (PARTITION BY N2.CO_OPERACION_ACTIVA ORDER BY APA.fe_vencimiento_cuota) AS FechaNum
    FROM NUMERADOS N2 JOIN [datamart].[dbo].[amortizacion_plan_activa] APA ON APA.co_operacion_activa = N2.CO_OPERACION_ACTIVA WHERE N2.CO_CONDICION = 'ORIGINAL' AND N2.FACILITY = A.FACILITY AND APA.fe_vencimiento_cuota &gt; @FE_MIGRACION) AS FechasNumeradas) 
    ELSE '' END) AS [FNQ.SCHEDULE.ACTUAL.AMT],
    
    ------------------------------ [SCHEDULE.BILL.TYPE]
     (
        SELECT 
            CASE WHEN A.HIJO_NUM = 1 THEN 'INSTALLMENT' 
            + CASE WHEN EXISTS (SELECT 1 FROM (SELECT COUNT(*) AS Total, COUNT(DISTINCT N2.MO_INTERES_USD) AS Distintos FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 
                AND N2.MO_APROBADO_MONEDA_ORIGEN = N2.MO_X_DESEMBOLSAR_ORIGEN) AS Conteos WHERE Total = Distintos) THEN '!!INSTALLMENT' ELSE '' END 
            + CASE WHEN EXISTS (SELECT 1 FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION) THEN '!!FUND.BILL' ELSE '' END 
            + CASE WHEN EXISTS (SELECT 1 FROM NUMERADOS N2  WHERE A.CO_CONDICION = 'ORIGINAL' AND N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' GROUP BY N2.CO_CONDICION) THEN '!!FUND.BILL' ELSE '' END 
        ELSE '' END 
    ) AS [SCHEDULE.BILL.TYPE],
    
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN (SELECT STRING_AGG('BILL.TYPE:' + CAST(Num AS VARCHAR) + ':1', '!!')
        FROM (SELECT ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS Num FROM (
                SELECT 1 AS Resultado FROM (SELECT SUM(N2.MO_CAPITAL_MONEDA_ORIGEN) AS Suma FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY) AS Sub WHERE Sub.Suma &gt; 0 
                UNION ALL               
                SELECT 1 AS Resultado FROM (SELECT COUNT(*) AS Total, COUNT(DISTINCT N2.MO_INTERES_USD) AS Distintos FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.HIJO_NUM &gt; 1 AND N2.MO_APROBADO_MONEDA_ORIGEN = N2.MO_X_DESEMBOLSAR_ORIGEN AND N2.CO_CONDICION &lt;&gt; 'KFW') AS Conteos WHERE Total = Distintos
                UNION ALL
                SELECT 1 AS Resultado FROM NUMERADOS N2 WHERE A.CO_CONDICION = 'ORIGINAL' AND N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
                UNION ALL                
                SELECT 1 AS Resultado FROM NUMERADOS N2 WHERE A.CO_CONDICION = 'ORIGINAL' AND N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION GROUP BY N2.CO_CONDICION              
            ) AS CondicionesCumplidas
        ) AS Numerados
        ) ELSE '' END  
    ) AS [FNQ.SCHEDULE.BILL.TYPE],

    
          ------------------------------ [XINTFUND.MARGIN.INTFUND]
     (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN ISNULL((SELECT STRING_AGG(CONDICION, '!!')
                FROM (SELECT 
                        CASE 
                            WHEN N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION THEN 'KWF'
                            WHEN N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION THEN 'FFC'
                            ELSE NULL
                        END AS CONDICION
                    FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY) AS CONDICIONES WHERE CONDICION IS NOT NULL
    ), '')  ELSE '' END) AS [XINTFUND.MARGIN.INTFUND],

    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN ISNULL((SELECT STRING_AGG('INTFUND:1:' + CAST(Pos AS VARCHAR), '!!')FROM (
          SELECT ROW_NUMBER() OVER (ORDER BY Tipo) AS Pos  FROM (
            SELECT 'KFW' AS Tipo FROM NUMERADOS N2 
              WHERE N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION
            UNION ALL
            SELECT 'FFC' FROM NUMERADOS N2 
              WHERE N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
          ) AS C
        ) AS R
      ), '') ELSE '' END
    ) AS [FNQ.XINTFUND.MARGIN.INTFUND],
        
        
    ----------------------------- XINTFUND.MARGIN.TERM
   
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN ISNULL((SELECT STRING_AGG(FE_ENCONTRADAS.FECHA, '!!')
        FROM (       
            SELECT CONVERT(VARCHAR, DATEDIFF(DAY, @FE_MIGRACION, N2.FE_VENCIMIENTO_KFW)) + 'D' AS FECHA FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION
            UNION ALL
            SELECT CONVERT(VARCHAR, DATEDIFF(DAY, @FE_MIGRACION, N2.FE_VENCIMIENTO_FFC)) + 'D' AS FECHA FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
          ) AS FE_ENCONTRADAS       
      ), '') ELSE '' END
    ) AS [XINTFUND.MARGIN.TERM],
    
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN ISNULL((SELECT STRING_AGG('TERM:' + CAST(Pos AS VARCHAR) + ':1', '!!')
        FROM (  SELECT ROW_NUMBER() OVER (ORDER BY Tipo) AS Pos FROM (
            SELECT 'KFW' AS Tipo FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION
            UNION ALL
            SELECT 'FFC' FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
          ) AS C
        ) AS R
      ) , '') ELSE '' END
    ) AS [FN.XINTFUND.MARGIN.TERM],   
    
   ------------------------------ [XINTFUND.MARGIN.DATE.FROM]   
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN ISNULL((SELECT STRING_AGG(FORMAT(CONVERT(date, FE_ENCONTRADAS.FECHA, 103), 'yyyyMMdd'), '!!')
        FROM (       
            SELECT @FE_MIGRACION AS FECHA FROM NUMERADOS N2 
            WHERE (N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION) OR 
            (N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION) OR 
            (N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION)
          ) AS FE_ENCONTRADAS       
      ) , '') ELSE '' END
    ) AS [XINTFUND.MARGIN.DATE.FROM],

    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN ISNULL((SELECT STRING_AGG('DATE.FROM:' + CAST(Pos AS VARCHAR) + ':1', '!!')
        FROM (
          SELECT ROW_NUMBER() OVER (ORDER BY Tipo) AS Pos
          FROM (
            SELECT 'KFW' AS Tipo FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION
            UNION ALL
            SELECT 'FFC' FROM NUMERADOS N2 WHERE N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
          ) AS C
        ) AS R), '') ELSE '' END
    ) AS [FNQ.XINTFUND.MARGIN.DATE.FROM],
    
    ------------------------------ [XINTFUND.MARGIN.DATE.TO]   
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN ISNULL((SELECT STRING_AGG(FORMAT(CONVERT(date, FE_ENCONTRADAS.FECHA, 103), 'yyyyMMdd'), '!!')
        FROM (       
            SELECT FE_VENCIMIENTO_KFW AS FECHA FROM NUMERADOS N2 
            WHERE N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION
            UNION ALL
            SELECT FE_VENCIMIENTO_FFC AS FECHA FROM NUMERADOS N2 
            WHERE N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
            UNION ALL
            SELECT FE_VENCIMIENTO_FFC AS FECHA FROM NUMERADOS N2            
            WHERE N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION
          ) AS FE_ENCONTRADAS       
      ) , '') ELSE '' END
    ) AS [XINTFUND.MARGIN.DATE.TO],

    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN ISNULL((SELECT STRING_AGG('DATE.TO:' + CAST(Pos AS VARCHAR) + ':1', '!!')
            FROM (SELECT ROW_NUMBER() OVER (ORDER BY Tipo) AS Pos
                FROM (
                    SELECT 'KFW' AS Tipo 
                    FROM NUMERADOS N2 
                    WHERE N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION
                    UNION ALL
                    SELECT 'FFC' AS Tipo 
                    FROM NUMERADOS N2 
                    WHERE N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
                    UNION ALL
                    SELECT 'KFW/FFC' AS Tipo 
                    FROM NUMERADOS N2             
                    WHERE N2.FACILITY = A.FACILITY 
                      AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION 
                      AND N2.CO_CONDICION = 'KFW' 
                      AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION
                ) AS C
            ) AS R), '') ELSE '' END) AS [FNQ.XINTFUND.MARGIN.DATE.TO],
    
     /* ---------------- XINTFUND.MARGIN.SUBLIM.AMT ---------------- */
    CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN
    ISNULL((
        SELECT STRING_AGG(x.amt_str, '!!')
        FROM (
            /* KFW futuro */
            SELECT CASE WHEN A.CURRENCY IN ('JPY','PYG')
                        THEN CONVERT(varchar(50), CAST(N2.MO_APROBADO_MONEDA_ORIGEN AS decimal(38,0)))
                        ELSE CONVERT(varchar(50), CAST(N2.MO_APROBADO_MONEDA_ORIGEN AS decimal(38,2)))
                   END AS amt_str
            FROM NUMERADOS N2
            WHERE N2.FACILITY = A.FACILITY
              AND N2.CO_CONDICION = 'KFW'
              AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION
              AND N2.MO_APROBADO_MONEDA_ORIGEN IS NOT NULL

            UNION ALL

            /* FFC futuro */
            SELECT CASE WHEN A.CURRENCY IN ('JPY','PYG')
                        THEN CONVERT(varchar(50), CAST(N2.MO_APROBADO_MONEDA_ORIGEN AS decimal(38,0)))
                        ELSE CONVERT(varchar(50), CAST(N2.MO_APROBADO_MONEDA_ORIGEN AS decimal(38,2)))
                   END
            FROM NUMERADOS N2
            WHERE N2.FACILITY = A.FACILITY
              AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
              AND N2.MO_APROBADO_MONEDA_ORIGEN IS NOT NULL

            UNION ALL

            /* Ambos (FFC y KFW) futuros */
            SELECT CASE WHEN A.CURRENCY IN ('JPY','PYG')
                        THEN CONVERT(varchar(50), CAST(N2.MO_APROBADO_MONEDA_ORIGEN AS decimal(38,0)))
                        ELSE CONVERT(varchar(50), CAST(N2.MO_APROBADO_MONEDA_ORIGEN AS decimal(38,2)))
                   END
            FROM NUMERADOS N2
            WHERE N2.FACILITY = A.FACILITY
              AND N2.FE_VENCIMIENTO_FFC  &gt; @FE_MIGRACION
              AND N2.FE_VENCIMIENTO_KFW  &gt; @FE_MIGRACION
              AND N2.MO_APROBADO_MONEDA_ORIGEN IS NOT NULL
        ) AS x
    ), '')
    ELSE '' END AS [XINTFUND.MARGIN.SUBLIM.AMT]
,

    

        
    
    /* ---------------- FNQ.XINTFUND.MARGIN.SUBLIM.AMT (sin ventana dentro de STRING_AGG) ---------------- */
CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN
(
  SELECT STRING_AGG('SUBLIM.AMT:' + CAST(n.seq AS varchar(10)) + ':1', '!!')
  FROM (
    /* Primero genero las filas que aplican, con un 'ord' fijo para controlar el orden */
    SELECT ROW_NUMBER() OVER (ORDER BY s.ord) AS seq
    FROM (
      /* 1) KFW futuro */
      SELECT 1 AS ord
      WHERE EXISTS (
        SELECT 1
        FROM NUMERADOS N2
        WHERE N2.FACILITY = A.FACILITY
          AND N2.CO_CONDICION = 'KFW'
          AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION
          AND N2.MO_APROBADO_MONEDA_ORIGEN IS NOT NULL
      )

      UNION ALL

      /* 2) FFC futuro */
      SELECT 2 AS ord
      WHERE EXISTS (
        SELECT 1
        FROM NUMERADOS N2
        WHERE N2.FACILITY = A.FACILITY
          AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
          AND N2.MO_APROBADO_MONEDA_ORIGEN IS NOT NULL
      )

      UNION ALL

      /* 3) Ambos (FFC y KFW) futuros */
      SELECT 3 AS ord
      WHERE EXISTS (
        SELECT 1
        FROM NUMERADOS N2
        WHERE N2.FACILITY = A.FACILITY
          AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
          AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION
          AND N2.MO_APROBADO_MONEDA_ORIGEN IS NOT NULL
      )
    ) AS s
  ) AS n
)
ELSE '' END AS [FNQ.XINTFUND.MARGIN.SUBLIM.AMT]
,
    
     ------------------------------ [XINTFUND.MARGIN.MARGIN]ta_cmpnscion
    (CASE WHEN A.CO_CONDICION = 'ORIGINAL' THEN ISNULL((SELECT STRING_AGG(CONVERT(VARCHAR, VALOR), '!!')
                FROM (SELECT CONVERT(VARCHAR, ABS(N2.TA_CMPNSCION)) AS VALOR FROM NUMERADOS N2 
                    WHERE N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
                    UNION ALL
                    SELECT CONVERT(VARCHAR, ABS(N2.TOTAL_MARGEN - B.TOTAL_MARGEN)) AS VALOR FROM NUMERADOS N2 LEFT JOIN NUMERADOS B ON N2.FACILITY = B.FACILITY AND N2.HIJO_NUM = B.HIJO_NUM + 1
                    WHERE N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION
                    UNION ALL
                    SELECT CONVERT(VARCHAR, ABS(N2.TA_CMPNSCION)) AS VALOR FROM NUMERADOS N2
                    WHERE N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
                ) AS FE_ENCONTRADAS), '') ELSE '' END
    ) AS [XINTFUND.MARGIN.MARGIN],    

    (
    CASE 
        WHEN A.CO_CONDICION = 'ORIGINAL' THEN 
            ISNULL((
                SELECT STRING_AGG('MARGIN:' + CAST(POS AS VARCHAR) + ':1', '!!')
                FROM (
                    SELECT ROW_NUMBER() OVER (ORDER BY TIPO) AS POS
                    FROM (
                        SELECT 'KFW' AS TIPO 
                        FROM NUMERADOS N2 
                        WHERE N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION
                        UNION ALL
                        SELECT 'FFC' 
                        FROM NUMERADOS N2 
                        WHERE N2.FACILITY = A.FACILITY AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
                        UNION ALL
                        SELECT CONVERT(VARCHAR, ABS(N2.TA_CMPNSCION)) 
                        FROM NUMERADOS N2
                        WHERE N2.FACILITY = A.FACILITY AND N2.CO_CONDICION = 'KFW' AND N2.FE_VENCIMIENTO_KFW &gt; @FE_MIGRACION AND N2.FE_VENCIMIENTO_FFC &gt; @FE_MIGRACION
                    ) AS C
                ) AS R
            ), '')
        ELSE ''
    END
) AS [FNQ.XINTFUND.MARGIN.MARGIN]

FROM NUMERADOS A
LEFT JOIN NUMERADOS B
  ON A.FACILITY = B.FACILITY
 AND A.HIJO_NUM = B.HIJO_NUM + 1
WHERE A.TOTAL_HIJOS &gt;= 2
  AND A.GRUPO_TIENE_1508 = 1-- AND A.FACILITY IN ('CFX0000002356  ')
ORDER BY A.PADRE_SUPERIOR ASC, A.FACILITY ASC, A.HIJO_NUM ASC;

</property>
